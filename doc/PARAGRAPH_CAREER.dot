digraph ParagraphCareer {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.38,
         fontname="Helvetica", label="A paragraph's career", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12,
        fillcolor="#edf4fb", color="#466580", margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#526473", arrowsize=0.7];

  html [label="HTML + CSS", fillcolor="#f3f3f3"];
  dom [label="1. htmlinput.Document\nStyled DOM", group=main];
  tree [label="2. documentlayout.Document\nRenderNode → normalized LayoutNode tree", group=main];
  input [label="3. documentlayout.InlineGroup\nText, styles, paint, source maps, object anchors", group=main];
  text [label="4. styled.Text + FontTextRun records\nItemized typography styles", group=main];
  bidi [label="5. styled.Paragraph / khipu.ParagraphInput\nParagraph-wide bidi context and anchors", group=main];
  prep [label="6. paragraph.Prepared\nImmutable khipu.Khipu + Discovery", group=main, fillcolor="#eaf5e9"];
  bound [label="7. khipu.AtomicBinding\nShared material + copied atomic advances", group=main, fillcolor="#eaf5e9"];
  breaks [label="8. Immutable khipu.Tikray\nCaptured geometry + selected decisions", group=main, fillcolor="#eaf5e9"];
  frozen [label="9. khipu.FrozenKhipu\nImmutable horizontal lines", group=main, fillcolor="#fff1d8"];
  vlist [label="10. layout.VList + layout.Box\nPositioned full-height line boxes\nPublished in paragraph.Result", group=main, fillcolor="#fff1d8"];
  document [label="11. documentlayout.Result\nParagraphs + surrounding CSS geometry", group=main, fillcolor="#fff1d8"];

  measure [label="Optional measurement\nkhipu.IntrinsicWidths", fillcolor="#f3f3f3"];
  assembly [label="Retained source styles\n+ resolved line-height\n+ atomic box geometry", fillcolor="#f3f3f3"];
  css [label="CSS block placement\nPadding, borders, margins\nand containing-block coordinates", fillcolor="#f3f3f3"];

  html -> dom -> tree -> input;
  input -> text [label="StyleMapper.ItemizeInline"];
  text -> bidi -> prep;
  prep -> bound [label="bind object advances"];
  bound -> breaks [label="line breaking"];
  breaks -> frozen [label="freeze selected lines"];
  frozen -> vlist [label="CSS line-height assembly"];
  vlist -> document;

  prep -> measure [style=dashed, label="MeasureIntrinsic"];
  assembly -> vlist [style=dashed, label="assembly inputs"];
  css -> document [style=dashed, label="surrounding geometry"];
  { rank=same; prep; measure; }
  { rank=same; frozen; assembly; }
  { rank=same; vlist; css; }
}
